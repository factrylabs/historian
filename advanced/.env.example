# Copy to .env and fill in. Docker Compose reads .env automatically.
# Keep the file: it is read on every `docker compose` invocation, and losing it
# makes the deployment unrecoverable.

# Required. Compose refuses to start if any of these is unset.
DB_PASSWORD=
INFLUXDB_ADMIN_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=

# Optional overrides. Defaults live in docker-compose.yml; see README.md.
#VERSION=
#GF_VERSION=
#GF_HISTORIAN_PLUGIN_VERSION=

# Bind the plain-HTTP endpoints to loopback when a TLS reverse proxy is in
# front of them. The gRPC port stays on 0.0.0.0 for remote collectors.
#REST_BIND_ADDRESS=127.0.0.1
#GF_BIND_ADDRESS=127.0.0.1
#GF_SERVER_ROOT_URL=https://historian.example.com/grafana
